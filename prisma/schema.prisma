generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SettingDataType {
  STRING
  NUMBER
  BOOLEAN
  OBJECT
}

enum PayoutType {
  FSP
  VENDOR
}

enum PayoutMode {
  ONLINE
  OFFLINE
}

enum PayoutTransactionType {
  TOKEN_TRANSFER
  FIAT_TRANSFER
  VENDOR_REIMBURSEMENT
}

enum PayoutTransactionStatus {
  PENDING
  TOKEN_TRANSACTION_INITIATED
  TOKEN_TRANSACTION_COMPLETED
  TOKEN_TRANSACTION_FAILED
  FIAT_TRANSACTION_INITIATED
  FIAT_TRANSACTION_COMPLETED
  FIAT_TRANSACTION_FAILED
  COMPLETED
  FAILED
}

enum GroupPurpose {
  BANK_TRANSFER
  MOBILE_MONEY
  COMMUNICATION
  GENERAL
}

enum RedemptionStatus {
  REQUESTED
  APPROVED
  REJECTED
}

// ++++++++++++++++++ START: beneficiaries +++++++++++++++++++++++++++

model Beneficiary {
  id            Int     @id @default(autoincrement()) @db.Integer()
  uuid          String  @unique @db.Uuid()
  walletAddress String  @unique
  phone         String?

  gender    Gender? @default(UNKNOWN)
  benTokens Int?    @default(0)
  extras    Json?

  isVerified Boolean @default(false)

  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime?                     @updatedAt()
  deletedAt                    DateTime?
  BeneficiaryRedeem            BeneficiaryRedeem[]
  BeneficiaryToGroup           BeneficiaryToGroup[]
  beneficiaryInkindRedemptions BeneficiaryInkindRedemption[]

  @@map("tbl_beneficiaries")
}

model BeneficiaryGroups {
  id   Int    @id @default(autoincrement()) @db.Integer()
  uuid String @unique @default(uuid())

  name String

  groupPurpose GroupPurpose?

  tokensReserved BeneficiaryGroupTokens[]
  beneficiaries  BeneficiaryToGroup[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt()
  deletedAt    DateTime?
  groupInkinds GroupInkind[]

  @@map("tbl_beneficiaries_groups")
}

model BeneficiaryToGroup {
  id            Int               @id @default(autoincrement()) @db.Integer()
  uuid          String            @unique @default(uuid())
  beneficiary   Beneficiary       @relation(fields: [beneficiaryId], references: [uuid])
  beneficiaryId String            @db.Uuid()
  group         BeneficiaryGroups @relation(fields: [groupId], references: [uuid])
  groupId       String

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()

  @@unique([beneficiaryId, groupId])
  @@map("tbl_beneficiaries_to_groups")
}

model BeneficiaryGroupTokens {
  id   Int    @id @default(autoincrement()) @db.Integer()
  uuid String @unique @default(uuid())

  title          String
  numberOfTokens Int    @default(0)

  status      String  @default("NOT_DISBURSED")
  isDisbursed Boolean @default(false)
  info        Json?

  groupId          String
  beneficiaryGroup BeneficiaryGroups @relation(fields: [groupId], references: [uuid])

  payoutId String?  @unique
  payout   Payouts? @relation(fields: [payoutId], references: [uuid])

  createdBy String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()

  @@map("tbl_beneficiaries_groups_tokens")
}

model Payouts {
  int  Int    @id @default(autoincrement()) @db.Integer()
  uuid String @unique @default(uuid())

  type   PayoutType
  mode   PayoutMode
  status String?
  extras Json?

  payoutProcessorId     String? // refer to either a Vendor UUID or a PaymentProvider Id from rahat-offramp-service
  beneficiaryGroupToken BeneficiaryGroupTokens?
  beneficiaryRedeem     BeneficiaryRedeem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()

  @@map("tbl_beneficiaries_groups_payouts")
}

// ++++++++++++++++++ END: beneficiaries +++++++++++++++++++++++++++

// ++++++++++++++++++ START: @rumsan/settings +++++++++++++++++++++++++++
model Setting {
  name           String          @id @unique
  value          Json
  dataType       SettingDataType
  requiredFields String[]
  isReadOnly     Boolean         @default(false)
  isPrivate      Boolean         @default(true)

  @@map("tbl_settings")
}

// ++++++++++++++++++ END: @rumsan/settings +++++++++++++++++++++++++++

model Stakeholders {
  id   Int    @id @default(autoincrement()) @db.Integer()
  uuid String @unique @default(uuid())

  name         String
  email        String?
  phone        String?  @unique
  designation  String
  organization String
  district     String
  municipality String
  supportArea  String[]

  stakeholdersGroups StakeholdersGroups[]

  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()

  @@map("tbl_stakeholders")
}

model StakeholdersGroups {
  id   Int    @id @default(autoincrement()) @db.Integer()
  uuid String @unique @default(uuid())

  name String

  stakeholders Stakeholders[]

  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()

  @@map("tbl_stakeholders_groups")
}
model Stats {
  name  String  @id @unique
  data  Json
  group String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()

  @@map("tbl_stats")
}
model Vendor {
  id            Int     @id @default(autoincrement())
  uuid          String  @unique @db.Uuid()
  name          String
  walletAddress String  @unique
  phone         String?
  location      String?
  extras        Json?

  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime?                     @updatedAt()
  deletedAt                    DateTime?
  VendorTokenRedemption        VendorTokenRedemption[]
  BeneficiaryRedeem            BeneficiaryRedeem[]
  beneficiaryInkindRedemptions BeneficiaryInkindRedemption[]
  vendorInkindRedemptions      VendorInkindRedemption[]

  @@map("tbl_vendors")
}

// ============== OTHER CORE CVA SCHEMAS================
enum TokenRedemptionStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  STELLAR_VERIFIED
  STELLAR_FAILED
}

model VendorTokenRedemption {
  id               Int                   @id @default(autoincrement())
  uuid             String                @unique @default(uuid()) @db.Uuid()
  vendorUuid       String                @db.Uuid()
  redemptionStatus TokenRedemptionStatus @default(REQUESTED)
  tokenAmount      Int                   @default(0)

  // Additional fields for better tracking
  transactionHash String?
  approvedBy      String?
  approvedAt      DateTime?

  vendor Vendor @relation(fields: [vendorUuid], references: [uuid])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()

  @@map("tbl_vendor_token_redemption")
}

model BeneficiaryRedeem {
  id                       Int     @id @default(autoincrement())
  uuid                     String  @unique @default(uuid())
  beneficiaryWalletAddress String
  isCompleted              Boolean @default(false)
  amount                   Int     @default(0)

  transactionType PayoutTransactionType
  status          PayoutTransactionStatus @default(PENDING)
  fspId           String? // refer PaymentProvider Id from rahat-offramp-service
  txHash          String?

  Beneficiary Beneficiary @relation(fields: [beneficiaryWalletAddress], references: [walletAddress])
  vendorUid   String?     @db.Uuid()
  Vendor      Vendor?     @relation(fields: [vendorUid], references: [uuid])

  payoutId String?
  payout   Payouts? @relation(fields: [payoutId], references: [uuid])

  info Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()

  @@map("tbl_beneficiary_redeem")
}


// ============== END CORE CVA SCHEMAS================

// ============== Start OTP SCHEMAS ================
model Otp {
  id            Int      @id @default(autoincrement())
  phoneNumber   String?  @unique
  email         String?  @unique
  walletAddress String?  @unique
  otp           String?
  otpHash       String
  amount        Float
  expiresAt     DateTime

  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map(name: "tbl_otp")
}

// ============== End OTP SCHEMAS ================

// ============== Start PDF Generation Job SCHEMAS ================
model PdfGenerationJob {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  status    String   @default("pending")
  groupId   String?
  fileUrl   String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map(name: "tbl_pdf_generation_jobs")
}

// ============== End PDF Generation Job SCHEMAS ================

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

// ============== Start Grievance SCHEMAS ================
model Grievance {
  id              Int               @id @default(autoincrement())
  uuid            String            @unique @default(uuid()) @db.Uuid()
  reportedBy      String
  reporterContact String
  tags            String[]
  title           String
  type            GrievanceType
  description     String
  status          GrievanceStatus   @default(NEW)
  priority        GrievancePriority @default(LOW)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  createdByUser   Json
  resolvedAt      DateTime?
  closedAt        DateTime?

  @@map("tbl_grievances")
}

enum GrievanceStatus {
  NEW
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum GrievanceType {
  TECHNICAL
  NON_TECHNICAL
  OTHER
}

enum GrievancePriority {
  LOW
  MEDIUM
  HIGH
}

// ============== End Grievance SCHEMAS ================

// ============== Start Inkind SCHEMAS ================
enum InkindStockMovementType {
  ADD
  REMOVE
  LOCK
  UNLOCK
  REDEEM
}

model Inkind {
  id          Int     @id @default(autoincrement())
  uuid        String  @unique @default(uuid())
  name        String
  type        String
  description String?
  image       String?

  // Optional cached fields (recommended for performance)
  availableStock Int @default(0)

  stockMovements          InkindStockMovement[]
  groupInkinds            GroupInkind[]
  vendorInkindRedemptions VendorInkindRedemption[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()
  deletedAt DateTime?

  @@map("tbl_inkinds")
}

model InkindStockMovement {
  id       Int                     @id @default(autoincrement())
  uuid     String                  @unique @default(uuid())
  inkindId String
  quantity Int
  type     InkindStockMovementType

  // Optional reference fields
  groupInkindId String?
  redemptionId  String?

  inkind      Inkind                       @relation(fields: [inkindId], references: [uuid])
  groupInkind GroupInkind?                 @relation(fields: [groupInkindId], references: [uuid])
  redemption  BeneficiaryInkindRedemption? @relation(fields: [redemptionId], references: [uuid])

  createdAt DateTime @default(now())

  @@unique([redemptionId], name: "unique_redemption_movement")
  // ===== INDEXES =====
  @@index([inkindId]) // trigger + filtering
  @@index([inkindId, createdAt(sort: Desc)]) // timeline per inkind
  @@index([groupInkindId])
  @@index([redemptionId])
  @@index([type])
  @@map("tbl_inkind_stock_movements")
}

model GroupInkind {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  groupId  String
  inkindId String

  quantityAllocated Int
  quantityRedeemed  Int @default(0)

  group  BeneficiaryGroups @relation(fields: [groupId], references: [uuid])
  inkind Inkind            @relation(fields: [inkindId], references: [uuid])

  redemptions    BeneficiaryInkindRedemption[]
  stockMovements InkindStockMovement[]

  mode              PayoutMode?
  payoutProcessorId String? //

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()
  createdBy String?

  @@unique([groupId, inkindId]) // A group can’t get the same inkind twice accidentally.
  @@index([groupId])
  @@index([inkindId])
  @@map("tbl_group_inkinds")
}

model BeneficiaryInkindRedemption {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  beneficiaryWallet String
  groupInkindId     String

  quantity Int @default(1)

  beneficiary Beneficiary @relation(fields: [beneficiaryWallet], references: [walletAddress])
  groupInkind GroupInkind @relation(fields: [groupInkindId], references: [uuid])

  stockMovement InkindStockMovement?

  redeemedAt DateTime @default(now())

  txHash             String?
  status             String  @default("PENDING")
  otpExemptionReason String?

  vendorUid String? @db.Uuid()
  Vendor    Vendor? @relation(fields: [vendorUid], references: [uuid])

  @@index([groupInkindId])
  @@index([beneficiaryWallet])
  @@index([vendorUid])
  @@index([redeemedAt(sort: Desc)])
  @@map("tbl_beneficiary_inkind_redemptions")
}

model TempOfflineInkindRedemption {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  vendorId  String
  user      Json
  vendor    Json
  payloads  Json
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([vendorId])
  @@map("tbl_temp_offline_inkind_redemptions")
}

model TempOfflineRedemption {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  chainType String // 'evm' | 'stellar'
  vendorId  String?
  payoutId  String?
  payloads  Json // [{ redeemUuid, beneficiaryWalletAddress, vendorWalletAddress, amount }]
  status    String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("tbl_temp_offline_redemptions")
}

model VendorInkindRedemption {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  redemptionStatus RedemptionStatus @default(REQUESTED)
  quantity         Int              @default(1)

  transactionHash String?
  approvedBy      String?
  approvedAt      DateTime?

  inkindUuid String
  inkind     Inkind @relation(fields: [inkindUuid], references: [uuid])

  vendorUuid String @db.Uuid()
  vendor     Vendor @relation(fields: [vendorUuid], references: [uuid])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([vendorUuid])
  @@index([updatedAt(sort: Desc)])
  @@map("tbl_vendor_inkind_redemptions")
}

// ============== End Inkind SCHEMAS ================

//===============Transfer SCHEMAS ===================
model Transfer {
  id              Int             @id @default(autoincrement())
  transactionId   String          @unique()
  from            String
  to              String
  transactionHash String
  blockNumber     String
  value           String
  blockTimeStamp  String
  transactionType TransactionType
  status          String
  createdAt       DateTime        @default(now())

  @@map("tbl_transfer")
}

enum TransactionType {
  TREASURY
  VENDOR
  OFFRAMP
}

//==================End Transfer Schemas================

//=============== Start Group Cash Transfer Schemas ================
model GroupCashTransferDetail {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  name        String
  phone       String?
  bankDetails Json?

  extras Json?

  createdAt                DateTime                  @default(now())
  updatedAt                DateTime?                 @updatedAt()
  deletedAt                DateTime?
  groupCashTransferRecords GroupCashTransferRecord[]

  @@map("tbl_group_cash_transfer_details")
}

model GroupCashTransferRecord {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  title               String
  groupCashTransferId String

  amount            Float?  @default(0)
  payoutProcessorId String?

  status           String    @default("NOT_STARTED")
  disbursedAt      DateTime?
  txHash           String?
  disbursementInfo Json?

  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()
  deletedAt DateTime?

  groupCashTransfer GroupCashTransferDetail @relation(fields: [groupCashTransferId], references: [uuid])

  @@map("tbl_group_cash_transfer_records")
}

// ============== End Group Cash Transfer Schemas ================

// ============== Start Stellar Direct Disbursement Batch Schemas ================

enum StellarBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// One row per Stellar batch within a direct disbursement job.
/// Unique on (groupTokenUuid, batchIndex) so re-runs can skip COMPLETED batches.
model StellarDisburseBatch {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  /// FK to tbl_beneficiaries_groups_tokens.uuid
  groupTokenUuid String
  /// 1-based position within this disbursement run
  batchIndex     Int
  /// Total batches in this run (denormalised for convenience)
  totalBatches   Int

  status StellarBatchStatus @default(PENDING)

  /// Stellar transaction hash — null until COMPLETED
  txHash String?

  /// Number of recipients in this batch
  recipientCount Int
  /// Sum of amounts for this batch (stored as string to preserve decimal precision)
  totalAmount    String

  /// Full recipient list [{walletAddress, amount}]
  recipients Json

  /// Wall-clock timestamps
  startedAt   DateTime?
  completedAt DateTime?
  /// Processing time in ms
  timeTakenMs Int?

  /// Error message if FAILED
  error String?

  /// Attempt counter for retry tracking
  attemptCount Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()

  @@unique([groupTokenUuid, batchIndex], name: "unique_group_batch")
  @@index([groupTokenUuid])
  @@index([status])
  @@map("tbl_stellar_disburse_batches")
}

// ============== End Stellar Direct Disbursement Batch Schemas ================

// ++++++++++++++++++ START: IVR Templates ++++++++++++++++++++

model IvrTemplate {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  flowUrl     String?
  status      IvrStatus @default(DRAFT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("tbl_ivr_templates")
}

enum IvrStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ++++++++++++++++++ END: IVR Templates ++++++++++++++++++++
